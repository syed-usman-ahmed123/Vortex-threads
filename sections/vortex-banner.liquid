{%- style -%}
  .vortex-clean-banner-{{ section.id }} {
    width: 100%;
    min-height: 550px;
    height: 800px;
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--vortex-charcoal, #1A1A1A);
    overflow: hidden;
  }

  /* Base Background Image Class */
  .vortex-clean-banner__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    z-index: 1;
    border-radius: 0 !important;
  }

  /* Desktop vs Mobile Image Toggle */
  .vortex-clean-banner__bg--mobile {
    display: none;
  }

  /* Left Side Content Placement */
  .vortex-clean-banner__container {
    max-width: 1400px;
    width: 100%;
    margin: 0 auto;
    padding: 80px 24px;
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: flex-start;
  }

  .vortex-clean-banner__content {
    max-width: 600px;
  }

  .vortex-clean-banner__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--vortex-taupe, #7C7865);
    margin-bottom: 12px;
    display: block;
  }

  .vortex-clean-banner__title {
    font-size: clamp(32px, 4.5vw, 56px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0 0 18px 0;
    color: var(--vortex-bg-warm, #F9F8F6);
    line-height: 1.1;
  }

  .vortex-clean-banner__text {
    font-size: clamp(13px, 1.5vw, 16px);
    color: var(--vortex-silver, #B3B4B2);
    margin: 0 0 36px 0;
    line-height: 1.6;
  }

  .vortex-clean-banner__btn {
    display: inline-block;
    padding: 18px 40px;
    background-color: var(--vortex-taupe, #7C7865);
    color: var(--vortex-bg-warm, #F9F8F6);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid var(--vortex-taupe, #7C7865);
    border-radius: 0 !important;
    transition: all 0.3s ease;
  }

  .vortex-clean-banner__btn:hover {
    background-color: var(--vortex-bg-warm, #F9F8F6);
    color: var(--vortex-charcoal, #1A1A1A);
    border-color: var(--vortex-bg-warm, #F9F8F6);
  }

  @media screen and (max-width: 768px) {
    .vortex-clean-banner-{{ section.id }} {
      min-height: 450px;
      height: 550px;
    }
    
    .vortex-clean-banner__content {
      max-width: 100%;
    }

    /* Switch to Mobile Image on small screens */
    {%- if section.settings.image_mobile != blank -%}
      .vortex-clean-banner__bg--desktop {
        display: none;
      }
      .vortex-clean-banner__bg--mobile {
        display: block;
      }
    {%- endif -%}
  }
{%- endstyle -%}

<section class="vortex-clean-banner-{{ section.id }} vortex-anim vortex-anim--fade ">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="vortex-clean-banner__bg vortex-clean-banner__bg--desktop"
      loading="lazy"
      width="{{ section.settings.image.width | default: 2000 }}"
      height="{{ section.settings.image.height | default: 1000 }}"
    >
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'vortex-clean-banner__bg vortex-clean-banner__bg--desktop' }}
  {%- endif -%}

  {%- if section.settings.image_mobile != blank -%}
    <img
      src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="vortex-clean-banner__bg vortex-clean-banner__bg--mobile"
      loading="lazy"
      width="{{ section.settings.image_mobile.width | default: 1000 }}"
      height="{{ section.settings.image_mobile.height | default: 1200 }}"
    >
  {%- endif -%}
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="vortex-clean-banner__bg vortex-clean-banner__bg--desktop"
      loading="lazy"
      width="{{ section.settings.image.width | default: 2000 }}"
      height="{{ section.settings.image.height | default: 1000 }}"
    >
  {%- else -%}
    {{ 'lifestyle-2' | placeholder_svg_tag: 'vortex-clean-banner__bg vortex-clean-banner__bg--desktop' }}
  {%- endif -%}

  {%- if section.settings.image_mobile != blank -%}
    <img
      src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="vortex-clean-banner__bg vortex-clean-banner__bg--mobile"
      loading="lazy"
      width="{{ section.settings.image_mobile.width | default: 1000 }}"
      height="{{ section.settings.image_mobile.height | default: 1200 }}"
    >
  {%- endif -%}

  <div class="vortex-clean-banner__container">
    <div class="vortex-clean-banner__content">
      {%- if section.settings.subheading != blank -%}
        <span class="vortex-clean-banner__tag">{{ section.settings.subheading }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vortex-clean-banner__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <p class="vortex-clean-banner__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="vortex-clean-banner__btn">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vortex Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Background Image (Optional)"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tag",
      "default": "// BRAND ARCHIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RAW STREETWEAR DESIGN"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Pure visual storytelling with uncompromised aesthetic and structure."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Vortex Banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}