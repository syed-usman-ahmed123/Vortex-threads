{%- style -%}
      .vortex-ab-hero-{{ section.id }} {
        width: 100%;
        padding: 120px 24px 80px 24px;
        position: relative;
        background-image: linear-gradient(
      30deg,
      var(--vortext-charcoal, #1A1A1A) 0%,
      var(--vortext-charcoal, #1A1A1A) 50%,
      var(--vortex-silver, #B3B4B2) 100%
    );
        color: var(--vortex-bg-warm, #F9F8F6);
        overflow: hidden;
      }



      .vortex-ab-hero__container {
        max-width: 1200px;
        margin: 0 auto;
        position: relative;
        z-index: 2;
      }

      .vortex-ab-hero__tag {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--vortex-taupe, #7C7865);
        margin-bottom: 24px;
        display: block;
      }

      .vortex-ab-hero__title {
        font-size: clamp(36px, 6vw, 76px);
        /* font-size: 76px; */
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -2px;
        line-height: 1.05;
        margin: 0 0 32px 0;
        color: var(--vortex-bg-warm, #F9F8F6);
        /* max-width: 1000px; */
        text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);

        /* FLUID FONT GLITCH FIX */
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        contain: layout style;
        will-change: transform;
      }

      .vortex-ab-hero__lead {
        font-size: clamp(16px, 2vw, 22px);
        line-height: 1.5;
        color: var(--vortex-silver, #B3B4B2);
        /* max-width: 750px; */
        margin: 0;
        font-weight: 400;
      }



      @media screen and (max-width: 768px) {
        .vortex-ab-hero-{{ section.id }} {
          padding: 80px 20px 50px 20px;
        }

      }
{%- endstyle -%}

<div class="vortex-ab-hero-{{ section.id }} vortex-anim vortex-anim--fade">
  <div class="vortex-ab-hero__container">
    {%- if section.settings.subheading != blank -%}
      <span class="vortex-ab-hero__tag">{{ section.settings.subheading }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="vortex-ab-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.lead_text != blank -%}
      <p class="vortex-ab-hero__lead">{{ section.settings.lead_text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vortex About Hero",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tag",
      "default": "// 01. BRAND MANIFESTO"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Main Heading",
      "default": "WE DO NOT DESIGN FOR TRENDS. WE ENGINEER FOR STRUCTURE."
    },
    {
      "type": "textarea",
      "id": "lead_text",
      "label": "Lead Subtitle",
      "default": "VORTEX THREADS was founded on the rejection of disposable fashion. We construct architectural garments designed to endure."
    }
  ],
  "presets": [
    {
      "name": "Vortex About Hero",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
