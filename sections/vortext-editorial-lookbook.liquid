{%- style -%}
  .vortex-grid-{{ section.id }} {
    width: 100%;
    padding: 80px 24px;
    background-color: var( --vortext-white, #FFFFFF);
    color: var(--vortex-charcoal, #1A1A1A);
  }

  .vortex-grid__header {
    max-width: 1400px;
    margin: 0 auto 10px auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    /* border-bottom: 1px solid var(--vortex-silver, #B3B4B2); */
    padding-bottom: 10px;
  }

  .vortex-grid__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--vortex-taupe, #7C7865);
    margin-bottom: 8px;
    display: block;
  }

  .vortex-grid__title {
    font-size: clamp(24px, 3.5vw, 42px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    margin: 0;
    color: var(--vortex-charcoal, #1A1A1A);
  }

  .vortex-grid__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 20px;
  }

  .vortex-grid__item {
    position: relative;
    overflow: hidden;
    background-color: var(--vortex-card-bg, #EFECE6);
    height: 650px;
    text-decoration: none;
    display: block;
  }

  /* Asymmetric Brutalist Grid Spans */
  .vortex-grid__item:nth-child(1) { grid-column: span 7; min-height: 400px; }
  .vortex-grid__item:nth-child(2) { grid-column: span 5; min-height: 400px; }
  .vortex-grid__item:nth-child(3) { grid-column: span 5; min-height: 400px; }
  .vortex-grid__item:nth-child(4) { grid-column: span 7; min-height: 400px; }

  .vortex-grid__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vortex-grid__item:hover .vortex-grid__img {
    transform: scale(1.03);
  }

  .vortex-grid__caption {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 30px;
    background: linear-gradient(to top, rgba(26, 26, 26, 0.85) 0%, rgba(26, 26, 26, 0) 100%);
    z-index: 2;
  }

  .vortex-grid__caption-title {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    margin: 0 0 6px 0;
    color: var(--vortex-white, #FFFFFF);
  }

  .vortex-grid__caption-sub {
    font-size: 11px;
    color: var(--vortex-white, #FFFFFF);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0;
    font-weight: 600;
  }

  @media screen and (max-width: 768px) {
    .vortex-grid__item:nth-child(n) {
      grid-column: span 12 !important;
      min-height: 350px !important;
    }
    .vortex-grid__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
{%- endstyle -%}

<section class="vortex-grid-{{ section.id }}">
  <div class="vortex-grid__header">
    <div>
      {%- if section.settings.subheading != blank -%}
        {% comment %} <span class="vortex-grid__tag">{{ section.settings.subheading }}</span> {% endcomment %}
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vortex-grid__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
  </div>

  <div class="vortex-grid__container">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}" class="vortex-grid__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.title | escape }}"
            class="vortex-grid__img"
            loading="lazy"
            width="{{ block.settings.image.width | default: 1200 }}"
            height="{{ block.settings.image.height | default: 500 }}"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'vortex-grid__img' }}
        {%- endif -%}

        {%- if block.settings.title != blank or block.settings.subtitle != blank -%}
          <div class="vortex-grid__caption">
            {%- if block.settings.title != blank -%}
              <h3 class="vortex-grid__caption-title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <p class="vortex-grid__caption-sub">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Vortex Editorial Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tag",
      "default": "// VISUAL ARCHIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "STREETWEAR LOOKBOOK"
    }
  ],
  "blocks": [
    {
      "type": "lookbook_item",
      "name": "Lookbook Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "HEAVYWEIGHT HOODIE"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "CHARCOAL BLACK"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product or Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vortex Editorial Lookbook",
      "category": "Custom Sections",
      "blocks": [
        { "type": "lookbook_item" },
        { "type": "lookbook_item" },
        { "type": "lookbook_item" },
        { "type": "lookbook_item" }
      ]
    }
  ]
}
{% endschema %}
