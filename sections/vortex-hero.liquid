{%- style -%}
  .vortex-split-hero {
    position: relative;
    width: 100%;
    min-height: 85vh;
    background: radial-gradient(
      circle at 75% 50%,
      rgba(124, 120, 101, 0.15) 0%,
      rgba(26, 26, 26, 0.95) 50%,
      #121212 100%
    );
    color: var(--vortex-bg-warm, #f9f8f6);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 0;
    overflow: hidden;
  }
  .vortex-split-hero__inner {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }


  .vortex-split-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 580px;
  }

  .vortex-split-hero__badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--vortex-silver, #b3b4b2);
    border: 1px solid var(--vortex-silver, #b3b4b2);
    padding: 6px 14px;
    margin-bottom: 24px;
  }

  .vortex-split-hero__title {
    font-size: clamp(38px, 5vw, 68px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: var(--vortex-bg-warm, #f9f8f6);
    margin: 0 0 20px 0;
  }

  .vortex-split-hero__description {
    font-size: 16px;
    line-height: 1.6;
    color: var(--vortex-silver, #b3b4b2);
    margin: 0 0 36px 0;
    max-width: 460px;
  }

  .vortex-split-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 42px;
    background-color: var(--vortex-taupe, #7c7865);
    color: var(--vortex-bg-warm, #f9f8f6);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--vortex-taupe, #7c7865);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vortex-split-hero__cta:hover {
    background-color: var(--vortex-bg-warm, #f9f8f6);
    color: var(--vortex-charcoal, #1a1a1a);
    border-color: var(--vortex-bg-warm, #f9f8f6);
    transform: translateY(-2px);
  }

  .vortex-split-hero__cta svg {
    transition: transform 0.3s ease;
  }

  .vortex-split-hero__cta:hover svg {
    transform: translateX(4px);
  }

 
  .vortex-split-hero__visual {
    position: relative;
    width: 100%;
    height: 700px;
 
    overflow: hidden;

  }

  .vortex-split-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .vortex-split-hero__visual:hover .vortex-split-hero__image {
    transform: scale(1.04);
  }

  .vortex-split-hero__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #121212;
    color: #333;
  }

  .vortex-split-hero__placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }

  /* Responsive Design for Mobile & Tablets */
  @media screen and (max-width: 989px) {
    .vortex-split-hero {
      padding: 40px 0;
      min-height: auto;
    }

    .vortex-split-hero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 0 20px;
    }

    .vortex-split-hero__visual {
      height: 650px;
      max-width: 500px;
      margin: 0 auto;
      width: 100%;
    }

    .vortex-split-hero__content {
      max-width: 100%;
    }

    .vortex-split-hero__image {
      object-fit: cover;
      object-position: center bottom;
    }
  }
{%- endstyle -%}

<section class="vortex-split-hero   vortex-anim vortex-anim--fade ">
  <div class="vortex-split-hero__inner ">
    <!-- Left: Content Column -->
    <div class="vortex-split-hero__content">
      {%- if section.settings.badge != blank -%}
        <span class="vortex-split-hero__badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="vortex-split-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="vortex-split-hero__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="vortex-split-hero__cta">
          <span>{{ section.settings.button_label }}</span>
          <svg width="10" height="10" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 8H15M15 8L8 1M15 8L8 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- Right: Visual Column -->
    <div class="vortex-split-hero__visual">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            class: 'vortex-split-hero__image',
            widths: '375, 750, 1100, 1400',
            alt: section.settings.title
        }}
      {%- else -%}
        <div class="vortex-split-hero__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vortex Split Hero",
  "tag": "section",
  "class": "section-vortex-split-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge / Subheading",
      "default": "450 GSM HEAVYWEIGHT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "ARCHITECTURAL UTILITY STREETWEAR"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Minimalist streetwear engineered with heavy-weight fabrics, precise proportions, and clean urban aesthetics."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    }
  ],
  "presets": [
    {
      "name": "Vortex Split Hero",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
