{%- style -%}
  .vortex-editorial-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--vortex-charcoal, #1A1A1A);
    background-attachment: fixed;

    {%- assign overlay_val = section.settings.overlay_opacity | divided_by: 100.0 -%}

    /* Bulletproof Background Image + Dynamic Overlay Stacked via CSS */
    {%- if section.settings.image != blank -%}
      background-image: linear-gradient(rgba(0, 0, 0, {{ overlay_val }}), rgba(0, 0, 0, {{ overlay_val }})),
                        url('{{ section.settings.image | image_url: width: 2000 }}');
    {%- else -%}
      background-image: linear-gradient(rgba(0, 0, 0, {{ overlay_val }}), rgba(0, 0, 0, {{ overlay_val }})),
                        linear-gradient(135deg, #1A1A1A 0%, #2A2A2A 100%);
    {%- endif -%}
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Content Layer (100% Sharp & Unaffected) */
  .vortex-editorial__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 900px;
    padding: 0 24px;
    text-align: center;
    color: var(--vortex-bg-warm, #F9F8F6);
    margin: 0 auto;
  }

  .vortex-editorial__tag {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--vortex-taupe, #7C7865);
    margin-bottom: 16px;
  }

  .vortex-editorial__heading {
    font-size: clamp(28px, 4.5vw, 56px);
    font-weight: 800;
    letter-spacing: -1px;
    text-transform: uppercase;
    line-height: 1.1;
    margin: 0 auto 20px auto;
    color: var(--vortex-bg-warm, #F9F8F6);
  }

  .vortex-editorial__subtext {
    font-size: clamp(13px, 1.5vw, 15px);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto 32px auto;
    color: var(--vortex-bg-warm, #F9F8F6);
    opacity: 0.9;
  }

  /* Button: Zero border-radius, Taupe -> White Hover */
  .vortex-editorial__btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    padding: 16px 38px;
    background-color: var(--vortex-taupe, #7C7865);
    color: var(--vortex-bg-warm, #F9F8F6);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    border-radius: 0 !important;
    transition: all 0.35s ease;
  }

  .vortex-editorial__btn:hover {
    background-color: var(--vortex-white, #FFFFFF);
    color: var(--vortex-charcoal, #1A1A1A);
    transform: translateY(-2px);
  }

  .vortex-editorial__btn svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    transition: transform 0.3s ease;
  }

  .vortex-editorial__btn:hover svg {
    transform: translateX(4px);
  }
{%- endstyle -%}

<section class="vortex-editorial-{{ section.id }} vortex-anim vortex-anim--fade ">
  <!-- Content Layer -->
  <div class="vortex-editorial__content">
    {%- if section.settings.subheading != blank -%}
      {% comment %} <span class="vortex-editorial__tag">{{ section.settings.subheading }}</span> {% endcomment %}
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="vortex-editorial__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="vortex-editorial__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="vortex-editorial__btn">
        <span>{{ section.settings.button_label }}</span>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vortex parallex banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 70,
      "unit": "%",
      "label": "Dark Overlay Opacity"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tag",
      "default": "// EDITORIAL SPOTLIGHT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "BRUTALIST FORM & TEXTURE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Heavyweight cotton constructions designed for raw, uncompromising urban environments."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP DROP 02"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "vh",
      "label": "Section Height"
    }
  ],
  "presets": [
    {
      "name": "Vortex parallex banner",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
