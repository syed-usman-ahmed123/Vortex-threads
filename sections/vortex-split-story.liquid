{%- style -%}
  .vortex-ab-story-{{ section.id }} {
    width: 100%;
    padding: 100px 24px;
    /* Soft Charcoal to Deep Silver/Grey Gradient */
    background: radial-gradient(
      circle at 0% 30%,
      rgba(124, 120, 101, 0.15) 0%,
      rgba(26, 26, 26, 0.95) 50%,
      #121212 100%
    );
    margin-top: 100px;
    color: var(--vortex-bg-warm, #F9F8F6);
    position: relative;
    overflow: hidden;
  }

  .vortex-ab-story__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .vortex-ab-story__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #111111;
    overflow: hidden;
    border-radius: 0 !important;
    /* Deep Brutalist Ambient Drop-Shadow */
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6),
                0 0 30px rgba(179, 180, 178, 0.05);
  }

  .vortex-ab-story__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0 !important;
  }

  .vortex-ab-story__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .vortex-ab-story__tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--vortex-taupe, #7C7865);
    margin-bottom: 16px;
    display: block;
  }

  .vortex-ab-story__title {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -1px;
    line-height: 1.1;
    margin: 0 0 24px 0;
    color: var(--vortex-bg-warm, #F9F8F6);
    text-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  }

  .vortex-ab-story__text {
    font-size: clamp(14px, 1.2vw, 16px);
    line-height: 1.7;
    color: var(--vortex-silver, #B3B4B2);
    margin: 0 0 20px 0;
  }

  @media screen and (max-width: 990px) {
    .vortex-ab-story__container {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .vortex-ab-story-{{ section.id }} {
      padding: 60px 20px;
    }
  }
{%- endstyle -%}

<div class="vortex-ab-story-{{ section.id }}">
  <div class="vortex-ab-story__container">
    <div class="vortex-ab-story__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.heading | escape }}"
          class="vortex-ab-story__img"
          loading="lazy"
          width="{{ section.settings.image.width | default: 1200 }}"
          height="{{ section.settings.image.height | default: 1500 }}"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'vortex-ab-story__img' }}
      {%- endif -%}
    </div>

    <div class="vortex-ab-story__content">
      {%- if section.settings.subheading != blank -%}
        <span class="vortex-ab-story__tag">{{ section.settings.subheading }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="vortex-ab-story__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.text_1 != blank -%}
        <p class="vortex-ab-story__text">{{ section.settings.text_1 }}</p>
      {%- endif -%}

      {%- if section.settings.text_2 != blank -%}
        <p class="vortex-ab-story__text">{{ section.settings.text_2 }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vortex Split Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Tag",
      "default": "// 04. THE ORIGIN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ARCHITECTURAL FIT. RAW ETHOS."
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Every garment from Vortex Threads begins with silhouette construction. We discard conventional fashion calendars to focus on raw, industrial aesthetics."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "From heavyweight custom textiles to boxy proportions, our pieces are crafted for durability, precision, and uncompromised streetwear identity."
    }
  ],
  "presets": [
    {
      "name": "Vortex Split Story",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
