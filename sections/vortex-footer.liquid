<style>
    .cf-{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .cf-{{ section.id }} .cf__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 4rem 3rem;
    }

    .cf-{{ section.id }} .cf__heading {
      margin: 0 0 1.6rem;
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: {{ section.settings.heading_color }};
    }

    .cf-{{ section.id }} .cf__text,
    .cf-{{ section.id }} .cf__text p {
      margin: 0 0 1.2rem;
      font-size: 1.4rem;
      line-height: 1.7;
      color: {{ section.settings.text_color }};
    }

    .cf-{{ section.id }} .cf__links {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .cf-{{ section.id }} .cf__links li {
      margin-bottom: 1rem;
    }

    .cf-{{ section.id }} .cf__links a {
      color: {{ section.settings.text_color }};
      text-decoration: none;
      font-size: 1.4rem;
      transition: color 0.25s ease, padding-left 0.25s ease;
    }

    .cf-{{ section.id }} .cf__links a:hover {
      color: {{ section.settings.accent_color }};
      padding-left: 0.5rem;
    }

    .cf-{{ section.id }} .cf__field {
      display: flex;
      border: 1px solid rgba(255, 255, 255, 0.3);
      overflow: hidden;
    }

    .cf-{{ section.id }} .cf__field input {
      flex: 1;
      min-width: 0;
      padding: 1.2rem 1.4rem;
      border: 0;
      background: transparent;
      color: {{ section.settings.text_color }};
      font-size: 1.4rem;
      outline: none;
    }

    .cf-{{ section.id }} .cf__field input::placeholder {
      color: {{ section.settings.text_color }};
      opacity: 0.6;
    }

    .cf-{{ section.id }} .cf__field button {
      padding: 0 1.8rem;
      border: none;
      background-color: var(--vortex-charcoal);
      color: var(--vortex-white);
      font-size: 1.3rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: opacity 0.25s ease;
    }

    {% comment %} .cf-{{ section.id }} .cf__field button:hover {
      opacity: 0.85;
    } {% endcomment %}

    .cf-{{ section.id }} .cf__msg {
      margin: 1rem 0 0;
      font-size: 1.3rem;
    }

    .cf-{{ section.id }} .cf__msg--error {
      color: #ff8a8a;
    }

    .cf-{{ section.id }} .cf__bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1.6rem;
      margin-top: 4rem;
      padding-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
    }

    .cf-{{ section.id }} .cf__copy {
      margin: 0;
      font-size: 1.3rem;
      opacity: 0.8;
    }

    .cf-{{ section.id }} .cf__payments {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .cf-{{ section.id }} .cf__payment-icon {
      height: 2.4rem;
      width: auto;
    }

    .cf-{{ section.id }} .cf__msg {
    transition: opacity 0.5s ease, max-height 0.5s ease, margin 0.5s ease;
    max-height: 60px;
    overflow: hidden;
  }

  .cf-{{ section.id }} .cf__msg.is-hidden {
    opacity: 0;
    max-height: 0;
    margin: 0;
  }

    @media screen and (max-width: 989px) {
      .cf-{{ section.id }} .cf__grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media screen and (max-width: 749px) {
      .cf-{{ section.id }} .cf__grid {
        grid-template-columns: 1fr;
      }
      .cf-{{ section.id }} .cf__bottom {
        flex-direction: column;
        align-items: flex-start;
      }
    }
</style>

<footer class="cf cf-{{ section.id }}">
  <div class="page-width">
    <div class="cf__grid">
      {%- for block in section.blocks -%}
        <div class="cf__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="cf__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="cf__text">{{ block.settings.text }}</div>
              {%- endif -%}

            {%- when 'menu' -%}
              {%- if block.settings.menu != blank -%}
                <ul class="cf__links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- if block.settings.text != blank -%}
                <p class="cf__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'cf__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="cf__field">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="Email address"
                    required
                    autocomplete="email"
                    aria-label="Email address"
                  >
                  <button type="submit">{{ block.settings.button_label }}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="cf__msg" data-cf-msg>Thanks for subscribing!</p>
                {%- endif -%}
                {%- if form.errors -%}
                  <p class="cf__msg cf__msg--error" data-cf-msg>{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="cf__bottom">
      <p class="cf__copy">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}
      </p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types != empty -%}
        <ul class="cf__payments">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'cf__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (function () {
    var section = document.querySelector('.cf-{{ section.id }}');
    if (!section) return;

    var messages = section.querySelectorAll('[data-cf-msg]');
    if (!messages.length) return;

    // Refresh par message wapas na aaye, is liye URL saaf karein
    try {
      var url = new URL(window.location.href);
      if (url.searchParams.has('customer_posted')) {
        url.searchParams.delete('customer_posted');
        url.hash = '';
        window.history.replaceState({}, document.title, url.pathname + url.search);
      }
    } catch (e) {}

    
    setTimeout(function () {
      messages.forEach(function (msg) {
        msg.classList.add('is-hidden');
        setTimeout(function () {
          msg.remove();
        }, 600);
      });
    }, 5000);
  })();
</script>

{% schema %}
{
  "name": "Vortex Footer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#1a1a1a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#d8d8d8" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent (hover, button)", "default": "#e63946" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About Us" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Short description about your brand goes here.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Quick Links" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" },
        { "type": "text", "id": "text", "label": "Description", "default": "Subscribe for updates and offers." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Vortex Footer",
      "category": "Custom Sections",
      "blocks": [
        { "type": "text" },
        { "type": "menu" },
        { "type": "menu", "settings": { "heading": "Support" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
